# ============================================================
# DrainGuard Backend - Environment Variables Example
# Copy this file to .env and fill in your real values
# ============================================================

# Port the Express server will listen on
PORT=3001

# Your Supabase project URL (from Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (keep this SECRET - full DB access)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Secret API key that IoT devices must send in the x-api-key header
DEVICE_API_KEY=your-device-api-key-here

# Admin password for dashboard admin actions (sent as x-admin-key header)
ADMIN_PASSWORD=your-admin-password-here

# The origin of your frontend (used for CORS whitelisting)
FRONTEND_ORIGIN=http://localhost:5500

# Optional: Telegram bot credentials for push alert notifications
# Leave empty to disable Telegram alerts
TELEGRAM_BOT_TOKEN=optional-telegram-bot-token
TELEGRAM_CHAT_ID=optional-telegram-chat-id
